# Neon Postgres (Prisma)
# From Neon dashboard → Connection details:
# - DATABASE_URL  = pooled connection string (ends with -pooler.…)
# - DIRECT_URL    = direct connection string (no -pooler) for migrations

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Cloudinary — free image hosting for card photos
# https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OpenAI — card photo auto-ID (bulk + single scan)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Clerk — auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# App URL (used for Stripe Checkout redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe billing (test mode)
# 1. Add your secret key from https://dashboard.stripe.com/test/apikeys
# 2. Create prices (or run: npm run stripe:setup)
# 3. Forward webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 4. Set BILLING_MOCK=false
BILLING_MOCK="false"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_LIFETIME="price_..."
